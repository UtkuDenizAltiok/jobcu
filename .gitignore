# ------------------------------------------------------------------
# Personal data and secrets: these must NEVER be uploaded to GitHub.
# (tools/check_no_secrets.py double-checks this before every commit.)
# ------------------------------------------------------------------
.env
.env.*
keys.json
keys.json.damaged
secrets.json
settings.json
settings.json.damaged
documents.json
cv.txt
cover_letter.txt
cover-letter.txt
*.log
jobcu.log.*
search-review.json
search-results.json
coverage.csv
*.key
*.pem
jobcu-data/

# Databases (saved jobs, job states)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Documents such as CVs and cover letters. Tests build fake ones in code (tests/conftest.py).
*.pdf
*.doc
*.docx
*.odt
*.rtf
*.pages

# ------------------------------------------------------------------
# Files the computer creates automatically
# ------------------------------------------------------------------
# Python and uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
build/
dist/
*.egg-info/

# macOS and Windows
.DS_Store
._*
Thumbs.db
desktop.ini

# Editors and AI tools: personal settings and chat histories stay private.
# AGENTS.md is the only shared assistant rulebook.
.vscode/
.idea/
.codex/
.claude/
.gemini/
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v*/
